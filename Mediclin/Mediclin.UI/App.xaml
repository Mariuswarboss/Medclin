<Application x:Class="Mediclin.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Mediclin.UI.Converters"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Typography.xaml" />
                <ResourceDictionary Source="Resources/Icons.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:StatusToColorConverter x:Key="StatusToColorConverter" />
            <conv:InitialsConverter x:Key="InitialsConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <conv:StringToUpperConverter x:Key="StringToUpperConverter" />
            <conv:CountToBadgeVisibilityConverter x:Key="CountToBadgeVisibilityConverter" />
            <conv:AnalyzeStatusToColorConverter x:Key="AnalyzeStatusToColorConverter" />
            <conv:AgeFromBirthConverter x:Key="AgeFromBirthConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
