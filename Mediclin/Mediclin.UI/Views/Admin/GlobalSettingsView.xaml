<UserControl x:Class="Mediclin.UI.Views.Admin.GlobalSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel>
            <Button Content="General" Style="{StaticResource SidebarMenuItem}" />
            <Button Content="Securitate" Style="{StaticResource SidebarMenuItem}" />
            <Button Content="API" Style="{StaticResource SidebarMenuItem}" />
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Setări globale" Style="{StaticResource HeadingText}" />
                <TextBox Style="{StaticResource RoundedTextBox}" Text="Nume clinică: MediClin" Margin="0,14,0,8" />
                <TextBlock Text="Culoare primară" Style="{StaticResource LabelText}" />
                <StackPanel Orientation="Horizontal" Margin="0,8">
                    <Rectangle Fill="{StaticResource PrimaryGreenBrush}" Width="28" Height="28" Margin="0,0,8,0" />
                    <Rectangle Fill="{StaticResource AccentGreenBrush}" Width="28" Height="28" Margin="0,0,8,0" />
                    <Rectangle Fill="{StaticResource BlueInfoBrush}" Width="28" Height="28" />
                </StackPanel>
                <CheckBox Content="Autentificare în doi pași obligatorie" />
                <TextBlock Text="Timeout sesiune" Style="{StaticResource LabelText}" Margin="0,12,0,0" />
                <Slider Minimum="15" Maximum="180" Value="60" Width="260" HorizontalAlignment="Left" />
                <Button Content="Salvează" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" CommandParameter="setari" HorizontalAlignment="Left" Margin="0,14,0,0" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
