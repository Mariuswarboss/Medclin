<Window x:Class="Mediclin.UI.Views.Admin.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediClin - Admin"
        MinWidth="1280"
        MinHeight="760"
        Height="820"
        Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="AdminTopButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,0,18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource PrimaryLightBrush}" Margin="0,0,10,0">
                        <TextBlock Text="M" Foreground="{DynamicResource PrimaryGreenDarkBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="MediClin" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Clinic management" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NumeComplet}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="OUT" Style="{StaticResource SecondaryButton}" Command="{Binding LogoutCommand}" MinWidth="58" Padding="10,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Dashboard" Style="{StaticResource AdminTopButton}" Command="{Binding NavigateCommand}" CommandParameter="AdminDashboard"/>
                    <Button Content="Utilizatori" Style="{StaticResource AdminTopButton}" Command="{Binding NavigateCommand}" CommandParameter="AdminUsers"/>
                    <Button Content="Medici" Style="{StaticResource AdminTopButton}" Command="{Binding NavigateCommand}" CommandParameter="AdminDoctors"/>
                    <Button Content="Financiar" Style="{StaticResource AdminTopButton}" Command="{Binding NavigateCommand}" CommandParameter="AdminFinancial"/>
                    <Button Content="Jurnale" Style="{StaticResource AdminTopButton}" Command="{Binding NavigateCommand}" CommandParameter="AdminLogs"/>
                    <Button Content="Setari" Style="{StaticResource AdminTopButton}" Command="{Binding NavigateCommand}" CommandParameter="AdminSettings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="18,16" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Clinic Admin Console" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{Binding ActiveNav}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>
