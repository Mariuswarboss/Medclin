<UserControl x:Class="Mediclin.UI.Views.Admin.DoctorsVerificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <TextBlock Text="Verificare medici" Style="{StaticResource HeadingText}" />
        <TabControl Margin="0,16,0,0">
            <TabItem Header="În așteptare">
                <ItemsControl ItemsSource="{Binding DoctorApprovals}" Margin="16">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Width="330" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="{Binding Specialty}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding Checklist}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource PrimaryGreenBrush}" Margin="0,8,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Aprobă" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.ApproveDoctorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0" />
                                        <Button Content="Respinge" Style="{StaticResource DangerButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </TabItem>
            <TabItem Header="Verificați">
                <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding DoctorApprovals}" Margin="16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Medic" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Specialitate" Binding="{Binding Specialty}" Width="180" />
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" />
    </StackPanel>
</UserControl>
