<UserControl x:Class="Mediclin.UI.Views.Doctor.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <ScrollViewer Padding="0,0,0,18" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{Binding WelcomeText}" Style="{StaticResource HeadingText}" />
                <TextBlock Text="{Binding TodayDateText}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="LIVE CLINIC PULSE" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding ActivePatientsNow}" FontSize="54" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LivePulseCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,18" />

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderBrushNeutral}" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="În cameră" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding InRoomCount}" FontSize="26" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderBrushNeutral}" BorderThickness="1" CornerRadius="18" Padding="14" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Așteptare" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding InAsteptareCount}" FontSize="26" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderBrushNeutral}" BorderThickness="1" CornerRadius="18" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Staff availability" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding StaffAvailabilityText}" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ShiftSummary}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="ROOM READY QUEUE" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding WaitingPatients}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrushNeutral}" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource BlueInfoBgBrush}">
                                                    <TextBlock Text="{Binding PacientNume, Converter={StaticResource InitialsConverter}}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BlueInfoBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PacientNume}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding MotivVizita}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="Cheamă pacientul"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="14,0"
                                                        Height="36"
                                                        Command="{Binding DataContext.UpdateStatusCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="MEDICAL TIMELINE" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Consultații în desfășurare și următoarele intrări în circuit" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource BorderBrushNeutral}" BorderThickness="1" CornerRadius="18" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding TotalAziCount, StringFormat={}{0} programări}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding MedicalTimeline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrushNeutral}" BorderThickness="1" CornerRadius="20" Padding="16" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource PrimaryLightBrush}">
                                                <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource PrimaryGreenDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PatientName}" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SecondaryLine}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding AppointmentTime}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Background="{Binding StatusTone}"
                                                    CornerRadius="16"
                                                    Padding="10,6"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusForeground}" FontWeight="SemiBold" FontSize="11"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="QUICK ACTIONS" Style="{StaticResource CardTitle}" />
                            <Button Content="Pacienți" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10"
                                    Command="{Binding DataContext.NavigateToPacientiCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Programări" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10"
                                    Command="{Binding DataContext.NavigateToProgramariCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Fișă medicală" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10"
                                    Command="{Binding DataContext.NavigateToEmrCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Rapoarte" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DataContext.NavigateToRapoarteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="WEATHER / TIME" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding CurrentTimeText}" FontSize="42" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentDateText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,14" TextWrapping="Wrap"/>
                            <Border Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderBrushNeutral}" BorderThickness="1" CornerRadius="18" Padding="14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="18" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Chișinău" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding WeatherText}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="CLINIC NOTE" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding ClinicMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
