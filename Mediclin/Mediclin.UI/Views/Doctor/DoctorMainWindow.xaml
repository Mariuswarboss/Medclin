<Window x:Class="Mediclin.UI.Views.Doctor.DoctorMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediClin - Medic"
        MinWidth="1280"
        MinHeight="760"
        Height="820"
        Width="1380"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="ActiveSidebarButton" TargetType="Button" BasedOn="{StaticResource SidebarMenuItem}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryGreenDarkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarAcrylicBrush}"
                BorderBrush="{StaticResource SidebarStrokeBrush}"
                BorderThickness="1"
                CornerRadius="28"
                Padding="18"
                Effect="{StaticResource SoftCardShadow}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Border Background="#F4FAF7" CornerRadius="18" Padding="14,12" Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="􀅼"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="16"
                                           Foreground="{StaticResource PrimaryGreenBrush}"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="MediClin" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Workspace medic"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="NAVIGARE" Style="{StaticResource CardTitle}" Margin="8,0,0,10"/>

                    <Button Command="{Binding NavigateToDashboardCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActiveSidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Dashboard">
                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryGreenDarkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard executiv"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToPacientiCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActiveSidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Pacienti">
                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryGreenDarkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding PacientiCount, StringFormat=Pacienți analytics ({0})}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToProgramariCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActiveSidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Programari">
                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryGreenDarkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding AziCount, StringFormat=Programări ({0})}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToEmrCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActiveSidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Emr">
                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryGreenDarkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/>
                            <TextBlock Text="Fișe medicale"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToRapoarteCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActiveSidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Rapoarte">
                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryGreenDarkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/>
                            <TextBlock Text="Rapoarte"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToSetariCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActiveSidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveNav}" Value="Setari">
                                        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryGreenDarkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/>
                            <TextBlock Text="Setări"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrushNeutral}" BorderThickness="1" CornerRadius="18" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding MedicNume}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UnreadCount, StringFormat=Notificări necitite: {0}}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SidebarIconButton}"
                            Command="{Binding LogoutCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,14,0,0"
                            ToolTip="Ieșire">
                        <TextBlock Text=""
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="22,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="18,16" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Hospital Executive Dashboard" FontSize="14" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding MedicNume}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BorderBrushNeutral}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ActiveNav}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Border Background="#FDEDEC"
                        BorderBrush="#F8D3D0"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14"
                        VerticalAlignment="Top"
                        Margin="0,0,0,14"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorRedBrush}" TextWrapping="Wrap"/>
                </Border>

                <Border Background="#F7FBF9"
                        BorderBrush="#E1F0EA"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="14"
                        VerticalAlignment="Top"
                        Margin="0,0,0,14"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center"/>
                        <TextBlock Text="Se pregătește spațiul medicului..." Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ContentControl Content="{Binding CurrentView}" Margin="0,20,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>
