<UserControl x:Class="Mediclin.UI.Views.Doctor.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="24">
            <TextBlock Text="Setări" Style="{StaticResource HeadingText}"/>
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Profil utilizator" Style="{StaticResource SectionTitleText}"/>
                    
                    <Grid Margin="0,14,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Prenume" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding Prenume, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Nume" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding Nume, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                    <TextBlock Text="Telefon" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                    <TextBlock Text="Link poză profil (Avatar URL)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding AvatarUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                    <TextBlock Text="Setări profesionale" Style="{StaticResource SectionTitleText}" Margin="0,8,0,0"/>
                    
                    <TextBlock Text="Durata consultației (minute)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding DurataConsultatie, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                    
                    <TextBlock Text="Tarif consultație (MDL)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding TarifConsultatie, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16"/>
                                        <TextBlock Text="Aspect" Style="{StaticResource SectionTitleText}" Margin="0,12,0,8"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16" HorizontalAlignment="Left">
                        <Button Content="Albă" Style="{StaticResource SecondaryButton}" Command="{Binding SchimbaTemaCuloareCommand}" CommandParameter="Light" Margin="0,0,8,0" />
                        <Button Content="Neagră" Style="{StaticResource SecondaryButton}" Command="{Binding SchimbaTemaCuloareCommand}" CommandParameter="Dark" />
                    </UniformGrid>
                    <TextBlock Text="{Binding ThemeStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
                                        <Button Content="Salvează modificările" Style="{StaticResource PrimaryButton}" Command="{Binding SalveazaCommand}" HorizontalAlignment="Left"/>
                    
                    <TextBlock Text="{Binding Mesaj}" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
