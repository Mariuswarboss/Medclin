<UserControl x:Class="Mediclin.UI.Views.Doctor.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ══════════════ CALENDAR ══════════════ -->
    <Border Style="{StaticResource CardBorder}" Margin="0,0,16,0">
      <StackPanel>

        <!-- Month nav -->
        <DockPanel LastChildFill="False" Margin="0,0,0,16">
          <Button DockPanel.Dock="Left" Content="&#8249;"
                  Style="{StaticResource IconButton}"
                  Command="{Binding PrevMonthCmd}"
                  Width="36" Height="36" FontSize="20"/>
          <Button DockPanel.Dock="Right" Content="&#8250;"
                  Style="{StaticResource IconButton}"
                  Command="{Binding NextMonthCmd}"
                  Width="36" Height="36" FontSize="20"/>
          <TextBlock Text="{Binding MonthYear}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
        </DockPanel>

        <!-- Day labels -->
        <UniformGrid Columns="7" Margin="0,0,0,8">
          <TextBlock Text="Lu" TextAlignment="Center" FontSize="11"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Text="Ma" TextAlignment="Center" FontSize="11"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Text="Mi" TextAlignment="Center" FontSize="11"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Text="Jo" TextAlignment="Center" FontSize="11"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Text="Vi" TextAlignment="Center" FontSize="11"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Text="S&#226;" TextAlignment="Center" FontSize="11"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}"/>
          <TextBlock Text="Du" TextAlignment="Center" FontSize="11"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}"/>
        </UniformGrid>

        <!-- Calendar grid -->
        <ItemsControl ItemsSource="{Binding CalDays}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Width="36" Height="36" Margin="1" Cursor="Hand"
                      Command="{Binding DataContext.SelectDayCmd,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}">
                <Button.Style>
                  <Style TargetType="Button">
                    <Setter Property="Background"      Value="Transparent"/>
                    <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize"        Value="13"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                  CornerRadius="18">
                            <StackPanel VerticalAlignment="Center">
                              <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                              <Ellipse x:Name="Dot" Width="4" Height="4"
                                       Margin="0,2,0,0" HorizontalAlignment="Center"
                                       Fill="{DynamicResource AccentGreenBrush}"
                                       Visibility="Collapsed"/>
                            </StackPanel>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bd" Property="Background"
                                      Value="{DynamicResource BackgroundSecondaryBrush}"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                        <Setter Property="Opacity"    Value="0.4"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding HasAppointments}" Value="True">
                        <Setter Property="FontWeight" Value="Bold"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsToday}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryGreenBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryGreenDarkBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Button.Content>
                  <TextBlock Text="{Binding DayNumber}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Button.Content>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Legend -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center">
          <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentGreenBrush}"
                   VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock Text="Zile cu programări" Style="{StaticResource MutedText}" FontSize="11"/>
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- ══════════════ DAY APPOINTMENTS LIST ══════════════ -->
    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
      <DockPanel>

        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,16">
          <TextBlock DockPanel.Dock="Left" Text="{Binding DayTitle}"
                     Style="{StaticResource SectionTitleText}"
                     VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Content="&#8635; Actualizează"
                  Style="{StaticResource SecondaryButton}"
                  Command="{Binding RefreshCmd}"
                  Padding="14,8" FontSize="12"/>
        </DockPanel>

        <!-- Loading bar -->
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                     Margin="0,0,0,12"
                     Visibility="{Binding Loading,
                     Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Error -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ErrorBgBrush}" CornerRadius="12" Padding="14,10"
                Margin="0,0,0,12"
                Visibility="{Binding Error,
                Converter={StaticResource NullToVisibilityConverter}}">
          <TextBlock Text="{Binding Error}"
                     Foreground="{DynamicResource ErrorRedBrush}"
                     FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Empty state -->
        <StackPanel DockPanel.Dock="Top"
                    HorizontalAlignment="Center" Margin="0,60,0,0"
                    Visibility="{Binding DayAppts.Count,
                    Converter={StaticResource ZeroToVisibilityConverter}}">
          <TextBlock Text="&#128197;" FontSize="52"
                     HorizontalAlignment="Center" Margin="0,0,0,16"/>
          <TextBlock Text="Nicio programare în această zi"
                     Style="{StaticResource MutedText}"
                     HorizontalAlignment="Center" FontSize="14"/>
          <TextBlock Text="Programările se creează din pagina de start."
                     Style="{StaticResource MutedText}"
                     HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Appointments -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding DayAppts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,10" CornerRadius="14"
                        Background="{DynamicResource BackgroundSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrushNeutral}"
                        BorderThickness="1" Padding="16,14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="60"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Time badge -->
                    <Border Width="52" Height="52" CornerRadius="12"
                            Background="{DynamicResource PrimaryLightBrush}"
                            VerticalAlignment="Center">
                      <TextBlock Text="{Binding OraText}"
                                 FontSize="15" FontWeight="Bold"
                                 Foreground="{DynamicResource PrimaryGreenDarkBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>

                    <!-- Patient + details -->
                    <StackPanel Grid.Column="1" Margin="14,0"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding PacientNume}"
                                 FontSize="14" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Margin="0,0,0,3"/>
                      <TextBlock Text="{Binding Tip}"
                                 Style="{StaticResource MutedText}"
                                 Margin="0,0,0,4"/>
                      <TextBlock Text="{Binding MotivVizita}"
                                 Style="{StaticResource MutedText}"
                                 TextWrapping="Wrap" FontSize="12"
                                 Visibility="{Binding MotivVizita,
                                 Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Status pill -->
                    <Border Grid.Column="2" CornerRadius="20"
                            Padding="14,6" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource NeutralPillBgBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Confirmata">
                              <Setter Property="Background" Value="{DynamicResource BlueInfoBgBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="In_asteptare">
                              <Setter Property="Background" Value="{DynamicResource WarningBgBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="In_cabinet">
                              <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Finalizata">
                              <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Anulata">
                              <Setter Property="Background" Value="{DynamicResource ErrorBgBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Status}"
                                 FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </DockPanel>
    </Border>

  </Grid>
</UserControl>
