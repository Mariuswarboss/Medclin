<UserControl x:Class="Mediclin.UI.Views.Doctor.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Calendar -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="‹" Width="36" Style="{StaticResource SecondaryButton}"
                            Command="{Binding PreviousMonthCommand}" />
                    <Button DockPanel.Dock="Right" Content="›" Width="36" Style="{StaticResource SecondaryButton}"
                            Command="{Binding NextMonthCommand}" />
                    <TextBlock Text="{Binding MonthYearText}" Style="{StaticResource SectionTitleText}"
                               HorizontalAlignment="Center" />
                </DockPanel>
                <UniformGrid Rows="1" Columns="7" Margin="0,12,0,4">
                    <TextBlock Text="Lu" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                    <TextBlock Text="Ma" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                    <TextBlock Text="Mi" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                    <TextBlock Text="Jo" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                    <TextBlock Text="Vi" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                    <TextBlock Text="Sâ" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                    <TextBlock Text="Du" HorizontalAlignment="Center" Style="{StaticResource MutedText}" />
                </UniformGrid>
                <ItemsControl ItemsSource="{Binding CalendarDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="2" Padding="0,8"
                                    Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Opacity" Value="0.35" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryGreenBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryGreenBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasAppointments}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding DayNumber}" HorizontalAlignment="Center" />
                                    <Ellipse Width="6" Height="6" Margin="0,4,0,0" HorizontalAlignment="Center"
                                             Visibility="{Binding HasAppointments, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Listă zi -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource HeadingText}"
                           Text="{Binding SelectedDate, StringFormat='Programări — {0:dd.MM.yyyy}'}" />
                <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding SelectedDateAppointments}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ora" Width="70"
                                            Binding="{Binding DataOra, StringFormat=HH:mm}" />
                        <DataGridTextColumn Header="Pacient" Binding="{Binding PacientNume}" Width="*" />
                        <DataGridTextColumn Header="Tip" Binding="{Binding Tip}" Width="110" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                        <DataGridTextColumn Header="Motiv" Binding="{Binding MotivVizita}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Formular -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Programare nouă" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Medic" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding AllMedici}"
                              SelectedItem="{Binding SelectedMedic}"
                              DisplayMemberPath="NumeComplet"
                              Style="{StaticResource RoundedComboBox}" />
                    <TextBlock Text="Pacient" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding AllPacients}"
                              SelectedItem="{Binding SelectedPacient}"
                              DisplayMemberPath="NumeComplet"
                              IsEditable="True"
                              Style="{StaticResource RoundedComboBox}" />
                    <TextBlock Text="Tip consultație" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding TipuriConsultatie}"
                              SelectedItem="{Binding SelectedTip}"
                              Style="{StaticResource RoundedComboBox}" />
                    <TextBlock Text="Interval disponibil" Style="{StaticResource FieldLabel}" Margin="0,12,0,8" />
                    <ItemsControl ItemsSource="{Binding AvailableSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Margin="0,0,8,8" Padding="10,6"
                                              Content="{Binding HourText}"
                                              Style="{StaticResource SecondaryButton}"
                                              Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Motiv vizită" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                    <TextBox Style="{StaticResource RoundedTextBox}" Height="72" TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Text="{Binding MotiVizita, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Confirmă programarea" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CreateProgramareCommand}" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
