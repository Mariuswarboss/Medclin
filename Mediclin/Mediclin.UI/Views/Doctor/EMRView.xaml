<UserControl x:Class="Mediclin.UI.Views.Doctor.EMRView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="EmrSaveButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Width" Value="220" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <Grid>
                                <ContentPresenter x:Name="LabelPresenter"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <Grid x:Name="SpinnerHost"
                                      Width="20"
                                      Height="20"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Grid.RenderTransform>
                                        <RotateTransform />
                                    </Grid.RenderTransform>
                                    <TextBlock Text="↻"
                                               FontSize="16"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsSaving, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="LabelPresenter" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SpinnerHost" Property="Visibility" Value="Visible" />
                                <Setter Property="Width" Value="44" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerHost"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             By="360"
                                                             Duration="0:0:0.9" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ SEARCH PANEL ══ -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorder}"
                Margin="0,0,0,14"
                Visibility="{Binding IsSearchPanelVisible,
                            Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Caută pacient"
                           Style="{StaticResource SectionTitleText}"
                           Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource RoundedTextBox}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Caută după nume sau email..."
                             FontSize="14"/>
                    <ProgressBar Grid.Column="1" IsIndeterminate="True"
                                 Width="18" Height="18" Margin="10,0,0,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsSearching,
                                 Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <!-- Results dropdown -->
                <Border Margin="0,8,0,0" CornerRadius="12"
                        Background="{DynamicResource BackgroundSecondaryBrush}"
                        Visibility="{Binding SearchResults.Count,
                        Converter={StaticResource ZeroToInverseVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding SearchResults}" MaxHeight="260">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectPatientCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Row" Background="Transparent"
                                                    CornerRadius="10" Padding="14,10"
                                                    Margin="4,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="17"
                                                            Background="{DynamicResource PrimaryLightBrush}">
                                                        <TextBlock Text="{Binding Initiale}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryGreenDarkBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NumeComplet}"
                                                                   FontWeight="SemiBold" FontSize="13"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Email}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding UltimaVizita, StringFormat={}{0:dd.MM.yyyy}}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background"
                                                            Value="{DynamicResource PrimaryLightBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>
        <!-- ══ TOAST ══ -->
        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,0,0,16"
                Visibility="{Binding ShowSaveToast, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ToastBorder}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowSaveToast}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0"
                                                         To="1"
                                                         Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="-26"
                                                         To="0"
                                                         Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform>
                <TranslateTransform Y="-16" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <Border Width="28"
                        Height="28"
                        CornerRadius="14"
                        Margin="0,0,12,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ErrorBgBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSaveToastSuccess}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SaveToastIcon}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorRedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSaveToastSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryGreenBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Text="{Binding SaveToastMessage}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource PrimaryLightBrush}">
                            <TextBlock Text="{Binding CurrentPatientInitials}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryGreenDarkBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPacient.NumeComplet}" Style="{StaticResource HeadingText}" FontSize="26"/>
                            <TextBlock Text="{Binding CurrentPatientMeta}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                            <Button Content="Schimbă pacientul"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="0" BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource AccentGreenBrush}"
                                    FontSize="11" HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    Command="{Binding OpenSearchCommand}"
                                    Click="OnChangePatientClick"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ Consultație Nouă"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding StartConsultatieNouaCommand}"
                                        Height="40" Padding="16,0" Margin="0,0,8,0"
                                        Visibility="{Binding CanStartNew, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Salvează Draft -->
                                <Button Command="{Binding SaveDraftCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="40" Padding="16,0" Margin="0,0,8,0"
                                        IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <ProgressBar IsIndeterminate="True" Width="12" Height="12"
                                                         Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="Salvează" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>

                                <!-- Trimite la pacient -->
                                <Button Command="{Binding TrimiteRezultatCommand}"
                                        Style="{StaticResource EmrSaveButton}"
                                        IsEnabled="{Binding IsTrimiting, Converter={StaticResource InverseBoolConverter}}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <ProgressBar IsIndeterminate="True" Width="14" Height="14"
                                                         Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Visibility="{Binding IsTrimiting, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="Trimite la pacient" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Salvează datele sau trimite fișa direct pacientului."
                                       Width="340"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       FontSize="11"
                                       TextAlignment="Right"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="SYMPTOM ENTRY" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Simptome și observații clinice introduse în cursul consultației."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,14"/>
                                <TextBox Style="{StaticResource RoundedTextBox}"
                                         Height="136"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         Text="{Binding Simptome, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="ICD-10 DIAGNOSIS" Style="{StaticResource CardTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Cod recomandat" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding DiagnosisOptions}"
                                                  SelectedItem="{Binding SelectedDiagnosisOption}"
                                                  DisplayMemberPath="DisplayText"
                                                  Style="{StaticResource RoundedComboBox}"
                                                  Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Cod final" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource RoundedTextBox}"
                                                 Margin="0,6,0,0"
                                                 Text="{Binding DiagnosticCod, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Descriere clinică" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                                <TextBox Style="{StaticResource RoundedTextBox}"
                                         Margin="0,6,0,0"
                                         Height="110"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         Text="{Binding DiagnosticText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="PRESCRIPTION BUILDER" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Lista activă și emiterea unei noi prescripții pentru pacient."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,14"/>
                                <ItemsControl ItemsSource="{Binding RetetActive}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BackgroundSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderBrushNeutral}"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="14"
                                                    Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding MedicNume}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding DataEmitere, StringFormat=Emisă la {0:dd.MM.yyyy}}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource PrimaryLightBrush}" CornerRadius="14" Padding="10,6">
                                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource PrimaryGreenDarkBrush}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="Emite rețetă"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding EmiteRetetaCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="VITAL SIGNS" Style="{StaticResource CardTitle}" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Text="Tensiune" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource RoundedTextBox}" Width="120" Margin="0,6,0,0" Text="{Binding Tensiune, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Text="Puls" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource RoundedTextBox}" Width="96" Margin="0,6,0,0" Text="{Binding Puls, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Text="Temperatură" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource RoundedTextBox}" Width="110" Margin="0,6,0,0" Text="{Binding Temperatura, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Text="Greutate" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource RoundedTextBox}" Width="110" Margin="0,6,0,0" Text="{Binding Greutate, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Text="Înălțime" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource RoundedTextBox}" Width="110" Margin="0,6,0,0" Text="{Binding Inaltime, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="CLINICAL NOTES" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Recomandări pentru pacient" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource RoundedTextBox}"
                                         Margin="0,6,0,0"
                                         Height="96"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         Text="{Binding Recomandari, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Note private medic" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                                <TextBox Style="{StaticResource RoundedTextBox}"
                                         Margin="0,6,0,0"
                                         Height="96"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         Text="{Binding NotePrvate, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="ACTIVE ALLERGIES" Style="{StaticResource CardTitle}" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource RoundedTextBox}"
                                             Text="{Binding AlergieSubstanta, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Substanta" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource RoundedTextBox}"
                                             Text="{Binding AlergieSeveritate, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Adauga" Style="{StaticResource PrimaryButton}" Command="{Binding AddAlergieCommand}" />
                                </Grid>
                                <TextBox Style="{StaticResource RoundedTextBox}"
                                         Text="{Binding AlergieObservatii, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Observatii alergie"
                                         Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Alergii}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource WarningBgBrush}" CornerRadius="14" Padding="10,6" Margin="0,0,8,8">
                                                <TextBlock Text="{Binding Substanta}" Foreground="{DynamicResource WarningAmberBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="TRIMITE ANALIZA" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Rezultatul apare automat in pagina de analize a pacientului."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,12"/>
                                <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding AnalizaLaborator, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding AnalizaTest, UpdateSourceTrigger=PropertyChanged}" Tag="Test" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Style="{StaticResource RoundedTextBox}" Text="{Binding AnalizaValoare, UpdateSourceTrigger=PropertyChanged}" Tag="Valoare" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource RoundedTextBox}" Text="{Binding AnalizaUnitate, UpdateSourceTrigger=PropertyChanged}" Tag="Unitate" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Style="{StaticResource RoundedTextBox}" Text="{Binding AnalizaStatus, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBox Style="{StaticResource RoundedTextBox}"
                                         Height="72"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         Text="{Binding AnalizaInterpretare, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,12" />
                                <Button Content="Trimite analiza pacientului" Style="{StaticResource PrimaryButton}" Command="{Binding TrimiteAnalizaCommand}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="CONSULTATION HISTORY" Style="{StaticResource CardTitle}" />
                                <ItemsControl ItemsSource="{Binding IstoricConsltatii}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BackgroundSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderBrushNeutral}"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="14"
                                                    Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DataConsultatie, StringFormat={}{0:dd MMM yyyy, HH:mm}}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DiagnosticText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
