<Window x:Class="Mediclin.UI.Views.Auth.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Mediclin.UI.Converters"
        xmlns:helpers="clr-namespace:Mediclin.UI.Helpers"
        Title="MediClin - Register" Height="720" Width="1100" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <Style x:Key="RolePillButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushNeutral}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryGreenBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryGreenBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryGreenDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource BackgroundPrimaryBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource PrimaryGreenBrush}" Padding="40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="♥ MediClin" FontSize="30" Foreground="White" FontWeight="SemiBold" />
                <TextBlock Text="Sistemul integrat de management clinic"
                           Margin="0,10,0,40"
                           Foreground="{DynamicResource PrimaryGreenLightBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource BackgroundPrimaryBrush}" Padding="60">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Cont nou" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                <Grid Margin="0,18,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <TextBox x:Name="TxtPrenume"
                                 Text="{Binding Prenume, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource RoundedTextBox}" />
                        <TextBlock IsHitTestVisible="False"
                                   Text="Prenume"
                                   Foreground="{DynamicResource PlaceholderBrush}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Prenume}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Prenume}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <TextBox x:Name="TxtNume"
                                 Text="{Binding Nume, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource RoundedTextBox}" />
                        <TextBlock IsHitTestVisible="False"
                                   Text="Nume"
                                   Foreground="{DynamicResource PlaceholderBrush}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Nume}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Nume}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}" />
                    <TextBlock IsHitTestVisible="False"
                               Text="exemplu@email.com"
                               Foreground="{DynamicResource PlaceholderBrush}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Email}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Email}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <TextBox Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}" />
                    <TextBlock IsHitTestVisible="False"
                               Text="+373 XX XXX XXX"
                               Foreground="{DynamicResource PlaceholderBrush}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Telefon}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Telefon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0"
                                         Style="{StaticResource RoundedPasswordBox}"
                                         helpers:PasswordBoxHelper.BindPassword="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding Parola, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                         Margin="0,0,6,0" />
                            <TextBox Grid.Column="0"
                                     Text="{Binding Parola, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource RoundedTextBox}"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Margin="0,0,6,0" />
                            <ToggleButton Grid.Column="1"
                                          Content="{Binding PasswordVisibilityText}"
                                          IsChecked="{Binding IsPasswordVisible, Mode=TwoWay}"
                                          Style="{StaticResource RolePillToggleButton}"
                                          MinWidth="76"
                                          Padding="10,8" />
                        </Grid>
                        <TextBlock IsHitTestVisible="False"
                                   Text="Minim 8 caractere"
                                   Foreground="{DynamicResource PlaceholderBrush}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Visibility="{Binding IsParolaEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0"
                                         Style="{StaticResource RoundedPasswordBox}"
                                         helpers:PasswordBoxHelper.BindPassword="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmareParola, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsConfirmPasswordVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                         Margin="0,0,6,0" />
                            <TextBox Grid.Column="0"
                                     Text="{Binding ConfirmareParola, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource RoundedTextBox}"
                                     Visibility="{Binding IsConfirmPasswordVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Margin="0,0,6,0" />
                            <ToggleButton Grid.Column="1"
                                          Content="{Binding ConfirmPasswordVisibilityText}"
                                          IsChecked="{Binding IsConfirmPasswordVisible, Mode=TwoWay}"
                                          Style="{StaticResource RolePillToggleButton}"
                                          MinWidth="76"
                                          Padding="10,8" />
                        </Grid>
                        <TextBlock IsHitTestVisible="False"
                                   Text="Repeta parola"
                                   Foreground="{DynamicResource PlaceholderBrush}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Visibility="{Binding IsConfirmareParolaEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Grid>

                <ProgressBar Height="8" Maximum="100" Value="{Binding PasswordStrength}" Margin="0,0,0,16">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Foreground" Value="{DynamicResource ErrorRedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PasswordStrength}" Value="66">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningAmberBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PasswordStrength}" Value="100">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <TextBlock Text="Selecteaza rolul:"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,8" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0"
                                  Style="{StaticResource RolePillButton}"
                                  Margin="0,0,8,0"
                                  IsChecked="{Binding IsPacientSelected, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="👤" Margin="0,0,6,0" />
                            <TextBlock Text="Pacient" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Grid.Column="1"
                                  Style="{StaticResource RolePillButton}"
                                  Margin="0,0,8,0"
                                  IsChecked="{Binding IsMedicSelected, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🩺" Margin="0,0,6,0" />
                            <TextBlock Text="Medic" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Grid.Column="2"
                                  Style="{StaticResource RolePillButton}"
                                  Margin="0"
                                  IsChecked="{Binding IsAdminSelected, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚙" Margin="0,0,6,0" />
                            <TextBlock Text="Admin" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>

                <StackPanel Margin="0,0,0,16" Visibility="{Binding IsMedicSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Specialitate medicală"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding Specialitati}"
                              SelectedItem="{Binding SelectedSpecialitate, Mode=TwoWay}"
                              DisplayMemberPath="Nume"
                              Style="{StaticResource RoundedComboBox}" />
                    <TextBlock Text="Specialitatea apare pe profilul dvs. și la verificarea de către administrator."
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,0,0,10"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Content="Inregistreaza-te" Style="{StaticResource PrimaryButton}" Command="{Binding RegisterCommand}" />

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource AccentGreenBrush}" Margin="0,6,0,0"
                           Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="Ai deja cont?" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Content="Autentifica-te" Style="{StaticResource LinkButton}" Margin="4,0,0,0"
                            Command="{Binding NavigateToLoginCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
