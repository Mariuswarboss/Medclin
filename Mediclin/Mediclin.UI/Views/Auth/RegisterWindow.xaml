<Window x:Class="Mediclin.UI.Views.Auth.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Mediclin.UI.Converters"
        xmlns:helpers="clr-namespace:Mediclin.UI.Helpers"
        Title="MediClin - Register" Height="720" Width="1100" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PrimaryGreenBrush}" Padding="40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="♥ MediClin" FontSize="30" Foreground="White" FontWeight="SemiBold" />
                <TextBlock Text="Sistemul integrat de management clinic"
                           Margin="0,10,0,40"
                           Foreground="{StaticResource PrimaryGreenLightBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="White" Padding="60">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Cont nou" FontSize="22" FontWeight="SemiBold" />

                <Grid Margin="0,18,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource RoundedTextBox}" Text="{Binding Prenume, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource RoundedTextBox}" Text="{Binding Nume, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBox Style="{StaticResource RoundedTextBox}" Margin="0,0,0,10" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource RoundedTextBox}" Margin="0,0,0,10" Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox Grid.Column="0" Margin="0,0,8,0" Height="38" Padding="12,8"
                                 helpers:PasswordBoxHelper.BindPassword="True"
                                 helpers:PasswordBoxHelper.BoundPassword="{Binding Parola, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox Grid.Column="1" Margin="8,0,0,0" Height="38" Padding="12,8"
                                 helpers:PasswordBoxHelper.BindPassword="True"
                                 helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmareParola, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <ProgressBar Height="8" Maximum="100" Value="{Binding PasswordStrength}" Margin="0,0,0,16">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Foreground" Value="Red" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PasswordStrength}" Value="66">
                                    <Setter Property="Foreground" Value="Orange" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PasswordStrength}" Value="100">
                                    <Setter Property="Foreground" Value="Green" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <Button Content="Inregistreaza-te" Style="{StaticResource PrimaryButton}" Command="{Binding RegisterCommand}" />

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource AccentGreenBrush}" Margin="0,6,0,0"
                           Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="Ai deja cont?" VerticalAlignment="Center" />
                    <Button Content="Autentifica-te" Style="{StaticResource LinkButton}" Margin="4,0,0,0"
                            Command="{Binding NavigateToLoginCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
