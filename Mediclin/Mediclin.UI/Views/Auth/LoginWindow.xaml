<Window x:Class="Mediclin.UI.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Mediclin.UI.Converters"
        xmlns:helpers="clr-namespace:Mediclin.UI.Helpers"
        Title="MediClin - Login" Height="700" Width="1100" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PrimaryGreenBrush}" Padding="40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="♥ MediClin" FontSize="30" Foreground="White" FontWeight="SemiBold" />
                <TextBlock Text="Sistemul integrat de management clinic"
                           Margin="0,10,0,40"
                           Foreground="{StaticResource PrimaryGreenLightBrush}" />

                <Border Background="#20FFFFFF" Padding="10" CornerRadius="6" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Programari rapide" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="Gestionati consultatiile in timp real." Foreground="{StaticResource PrimaryGreenLightBrush}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="#20FFFFFF" Padding="10" CornerRadius="6" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Dosar digital complet" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="Date medicale centralizate pentru echipa." Foreground="{StaticResource PrimaryGreenLightBrush}" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border Background="#20FFFFFF" Padding="10" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Comunicare securizata" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="Interactie medic-pacient intr-un singur loc." Foreground="{StaticResource PrimaryGreenLightBrush}" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="White" Padding="60">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Bun venit inapoi" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Autentificati-va pentru a accesa platforma"
                           Margin="0,6,0,24"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <ToggleButton Content="Medic" IsChecked="True" Margin="0,0,8,0" />
                    <ToggleButton Content="Pacient" Margin="0,0,8,0" />
                    <ToggleButton Content="Admin" />
                </StackPanel>

                <TextBox Style="{StaticResource RoundedTextBox}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />

                <PasswordBox Margin="0,0,0,10"
                             Height="38"
                             Padding="12,8"
                             helpers:PasswordBoxHelper.BindPassword="True"
                             helpers:PasswordBoxHelper.BoundPassword="{Binding Parola, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button Content="Am uitat parola" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,0,0,10" />
                <CheckBox Content="Tine-ma autentificat" Margin="0,0,0,16" />

                <Button Content="Autentificati-va"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}" />

                <ProgressBar Margin="0,12,0,0"
                             Height="4"
                             IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorText}"
                           Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <TextBlock Text="Nu ai cont?" VerticalAlignment="Center" />
                    <Button Content="Inregistreaza-te"
                            Style="{StaticResource LinkButton}"
                            Margin="4,0,0,0"
                            Command="{Binding NavigateToRegisterCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
