<Window x:Class="Mediclin.UI.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Mediclin.UI.Converters"
        xmlns:helpers="clr-namespace:Mediclin.UI.Helpers"
        Title="MediClin - Login"
        Icon="/Assets/logo-mediclin.png"
        Height="720"
        Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="34">
        <Border Style="{StaticResource CardBorder}" Padding="0" CornerRadius="28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource PrimaryGreenBrush}" CornerRadius="28,0,0,28" Padding="38">
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="116" Height="116" CornerRadius="24" Background="White" Padding="10" HorizontalAlignment="Left" Margin="0,0,0,18">
                            <Image Source="/Assets/logo-mediclin.png" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="MediClin" FontSize="34" Foreground="White" FontWeight="SemiBold" />
                        <TextBlock Text="Sistem integrat de management clinic"
                                   Margin="0,10,0,34"
                                   Foreground="#DDF7EF"
                                   FontSize="15" />

                        <Border Background="#26FFFFFF" Padding="16" CornerRadius="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Programari rapide" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock Text="Consultatii si pacienti intr-un singur loc." Foreground="#DDF7EF" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Background="#26FFFFFF" Padding="16" CornerRadius="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Dosar medical digital" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock Text="Fise, retete si analize sincronizate." Foreground="#DDF7EF" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Background="#26FFFFFF" Padding="16" CornerRadius="16">
                            <StackPanel>
                                <TextBlock Text="Comunicare securizata" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock Text="Medic si pacient conectati simplu." Foreground="#DDF7EF" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0,28,28,0" Padding="66">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bun venit inapoi" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Autentifica-te pentru a accesa platforma"
                                   Margin="0,8,0,28"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtEmail"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource RoundedTextBox}"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="Parola" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox Grid.Column="0"
                                         Style="{StaticResource RoundedPasswordBox}"
                                         helpers:PasswordBoxHelper.BindPassword="True"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding Parola, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                         Margin="0,0,8,0" />
                            <TextBox Grid.Column="0"
                                     Text="{Binding Parola, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource RoundedTextBox}"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                     Margin="0,0,8,0" />
                            <ToggleButton Grid.Column="1"
                                          Content="{Binding PasswordVisibilityText}"
                                          IsChecked="{Binding IsPasswordVisible, Mode=TwoWay}"
                                          Style="{StaticResource RolePillToggleButton}"
                                          MinWidth="88"
                                          Padding="12,8" />
                        </Grid>

                        <Button Content="Autentifica-te"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoginCommand}"
                                IsDefault="True" />

                        <ProgressBar Margin="0,12,0,0"
                                     Height="4"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource ErrorText}"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <TextBlock Text="Nu ai cont?" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="Inregistreaza-te"
                                    Style="{StaticResource LinkButton}"
                                    Margin="4,0,0,0"
                                    Command="{Binding NavigateToRegisterCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
