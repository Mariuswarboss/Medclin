<UserControl x:Class="Mediclin.UI.Views.Patient.LabResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24">
        <DockPanel LastChildFill="False">
            <TextBlock Text="Rezultate analize" Style="{StaticResource HeadingText}" />
            <Button DockPanel.Dock="Right" Content="Descarcă PDF" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}" CommandParameter="analize" />
        </DockPanel>
        <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding LabResults}" Height="280" Margin="0,16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="*" />
                <DataGridTextColumn Header="Rezultat" Binding="{Binding Value}" Width="120" />
                <DataGridTextColumn Header="Unitate" Binding="{Binding Unit}" Width="100" />
                <DataGridTextColumn Header="Interval normal" Binding="{Binding NormalRange}" Width="160" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Interpretare medicală" Style="{StaticResource SectionTitleText}" />
                <TextBlock Text="Valorile sunt monitorizate de medic. Rezultatele ridicate sau critice sunt marcate pentru discuție la următoarea consultație." TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
