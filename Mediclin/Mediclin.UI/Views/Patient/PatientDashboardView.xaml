<UserControl x:Class="Mediclin.UI.Views.Patient.PatientDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="24,20,24,24">
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding WelcomeText}" FontSize="22" FontWeight="SemiBold" Foreground="#1A1A18"/>
                    <TextBlock Text="{Binding TodayDate}" FontSize="13" Foreground="#888780" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="+ Programare nouă"
                        Command="{Binding OpenBookingCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="40"
                        Padding="20,0"/>
            </Grid>

            <UniformGrid Columns="3" Margin="0,0,0,20">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="URMĂTOAREA VIZITĂ" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding NextAppointmentText, TargetNullValue='', FallbackValue=''}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#0F6E56"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="REȚETE ACTIVE" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding ActivePrescriptions}" FontSize="28" FontWeight="SemiBold" Foreground="#1A1A18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ANALIZE NOI" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding NewLabResults}" FontSize="28" FontWeight="SemiBold" Foreground="#1A1A18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Visibility="{Binding IsBookingPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource CardBorder}"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="PROGRAMARE NOUĂ" Style="{StaticResource CardTitle}"/>

                    <TextBlock Text="Filtrează după specialitate:" Style="{StaticResource FieldLabel}"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,6,0,12">
                        <ListBox ItemsSource="{Binding Specialitati}"
                                 SelectedItem="{Binding SelectedSpecialitate, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="14,8" />
                                    <Setter Property="Margin" Value="0,0,8,0" />
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushNeutral}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="18">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryGreenDarkBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFC" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nume}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <TextBlock Text="Selectează medicul:" Style="{StaticResource FieldLabel}"/>
                    <ListView ItemsSource="{Binding AvailableDoctors}"
                              SelectedItem="{Binding SelectedMedic}"
                              BorderThickness="0"
                              Background="Transparent"
                              MaxHeight="220"
                              Margin="0,6,0,12">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" CornerRadius="8" Margin="0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F5F5F3"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="22" Background="#E1F5EE">
                                            <TextBlock Foreground="#085041"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Initiale, TargetNullValue='', FallbackValue=''}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding NumeCompletCuTitlu, TargetNullValue='', FallbackValue=''}"/>
                                            <TextBlock FontSize="12" Foreground="#888780" Text="{Binding SpecialitateNume, TargetNullValue='', FallbackValue=''}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock FontSize="11" Foreground="#0F6E56" Text="{Binding TarifText, TargetNullValue='', FallbackValue=''}"/>
                                                <TextBlock FontSize="11" Foreground="#888780" Text=" · "/>
                                                <TextBlock FontSize="11" Foreground="#888780" Text="{Binding DurataText, TargetNullValue='', FallbackValue=''}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="Selectează"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="12,6"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.SelectDoctorCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="Selectează data:" Style="{StaticResource FieldLabel}"/>
                    <DatePicker SelectedDate="{Binding SelectedDate}" Margin="0,6,0,12" Height="38"/>

                    <TextBlock Text="Ore disponibile:" Style="{StaticResource FieldLabel}"/>
                    <ProgressBar IsIndeterminate="True"
                                 Height="3"
                                 Margin="0,4"
                                 Visibility="{Binding IsSlotsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <ItemsControl ItemsSource="{Binding AvailableSlots}" Margin="0,4,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="4"
                                        Width="72"
                                        Height="34"
                                        Content="{Binding HourText}"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DataContext.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Tip consultație:" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                    <ComboBox ItemsSource="{Binding TipuriConsultatie}"
                              SelectedItem="{Binding SelectedTip}"
                              Style="{StaticResource RoundedComboBox}"
                              Margin="0,4,0,12"/>

                    <TextBlock Text="Motiv vizită:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding MotivVizita, UpdateSourceTrigger=PropertyChanged}"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Style="{StaticResource RoundedTextBox}"
                             Margin="0,4,0,12"/>

                    <TextBlock Text="{Binding BookingError, TargetNullValue='', FallbackValue=''}"
                               Foreground="#C0392B"
                               FontSize="12"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Visibility="{Binding BookingError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding BookingSuccess, TargetNullValue='', FallbackValue=''}"
                               Foreground="#27AE60"
                               FontSize="12"
                               Margin="0,0,0,8"
                               Visibility="{Binding BookingSuccess, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Anulează"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelBookingCommand}"
                                Margin="0,0,8,0"
                                Height="40"
                                Padding="20,0"/>
                        <Button Content="Confirmă programarea"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmBookingCommand}"
                                Height="40"
                                Padding="20,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0">
                <StackPanel>
                    <TextBlock Text="PROGRAMĂRILE URMĂTOARE" Style="{StaticResource CardTitle}"/>
                    <ItemsControl ItemsSource="{Binding UpcomingAppointments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,4" CornerRadius="8" Background="#F5F5F3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#E1F5EE" CornerRadius="8" Padding="4">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DataOra, StringFormat=dd}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="#085041"
                                                           TextAlignment="Center"/>
                                                <TextBlock Text="{Binding DataOra, StringFormat=MMM}"
                                                           FontSize="10"
                                                           Foreground="#0F6E56"
                                                           TextAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MedicNume, TargetNullValue='', FallbackValue=''}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SpecialitateNume, TargetNullValue='', FallbackValue=''}" FontSize="12" Foreground="#888780"/>
                                            <TextBlock Text="{Binding DataOra, StringFormat=HH:mm}" FontSize="11" Foreground="#0F6E56"/>
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                CornerRadius="20"
                                                Padding="10,4"
                                                Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                            <TextBlock Text="{Binding Status, TargetNullValue='', FallbackValue=''}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
