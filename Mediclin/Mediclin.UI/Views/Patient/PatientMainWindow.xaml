<Window x:Class="Mediclin.UI.Views.Patient.PatientMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediClin - Pacient" MinHeight="700" MinWidth="1200" Height="760" Width="1240" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundSecondaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource TopbarStyle}">
            <DockPanel LastChildFill="True" Margin="22,0">
                <TextBlock Text="♥ MediClin" Foreground="White" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,18,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="Acasă" Style="{StaticResource TopNavButton}" Command="{Binding NavigateCommand}" CommandParameter="PatientDashboard" />
                    <Button Content="Programările mele" Style="{StaticResource TopNavButton}" Command="{Binding NavigateCommand}" CommandParameter="PatientAppointments" />
                    <Button Content="Fișa mea" Style="{StaticResource TopNavButton}" Command="{Binding NavigateCommand}" CommandParameter="PatientEmr" />
                    <Button Content="Mesaje" Style="{StaticResource TopNavButton}" Command="{Binding NavigateCommand}" CommandParameter="PatientMessages" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Path Data="{StaticResource BellIcon}" Stroke="White" StrokeThickness="1.8" Width="18" Height="18" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding NumeComplet}" Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="Deconectare" Style="{StaticResource SecondaryButton}" Height="32" Command="{Binding LogoutCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushNeutral}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,20">
                    <TextBlock Text="PACIENT" Style="{StaticResource LabelText}" Margin="24,0,0,10" />
                    <Button Content="Tablou de bord" Style="{StaticResource SidebarMenuItem}" Command="{Binding NavigateCommand}" CommandParameter="PatientDashboard" />
                    <Button Content="Programările mele  2" Style="{StaticResource SidebarMenuItem}" Command="{Binding NavigateCommand}" CommandParameter="PatientAppointments" />
                    <Button Content="Fișă medicală" Style="{StaticResource SidebarMenuItem}" Command="{Binding NavigateCommand}" CommandParameter="PatientEmr" />
                    <Button Content="Rețete active  3" Style="{StaticResource SidebarMenuItem}" Command="{Binding NavigateCommand}" CommandParameter="PatientPrescriptions" />
                    <Button Content="Rezultate analize" Style="{StaticResource SidebarMenuItem}" Command="{Binding NavigateCommand}" CommandParameter="PatientLabs" />
                    <Button Content="Mesaje medic" Style="{StaticResource SidebarMenuItem}" Command="{Binding NavigateCommand}" CommandParameter="PatientMessages" />
                    <Button Content="Setări cont" Style="{StaticResource SidebarMenuItem}" Command="{Binding NavigateCommand}" CommandParameter="PatientSettings" />
                </StackPanel>
            </Border>
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>
