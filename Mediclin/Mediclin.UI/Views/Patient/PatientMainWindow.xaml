<Window x:Class="Mediclin.UI.Views.Patient.PatientMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediClin - Pacient" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="{StaticResource PrimaryGreenBrush}" LastChildFill="False">
            <TextBlock Text="MediClin" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center" />
            <Button Content="Deconectare" DockPanel.Dock="Right" Margin="0,10,16,10" Command="{Binding LogoutCommand}" />
        </DockPanel>
        <TextBlock Grid.Row="1" Text="{Binding MesajBunVenit}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" />
    </Grid>
</Window>
