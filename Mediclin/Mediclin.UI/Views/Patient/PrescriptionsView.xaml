<UserControl x:Class="Mediclin.UI.Views.Patient.PrescriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <TextBlock Text="Rețete active" Style="{StaticResource HeadingText}" />
                <Button DockPanel.Dock="Right" Content="Solicită reînnoire" Style="{StaticResource PrimaryButton}" Command="{Binding IssuePrescriptionCommand}" />
            </DockPanel>
            <Border Background="{StaticResource WarningBgBrush}" CornerRadius="8" Padding="14" Margin="0,12,0,16">
                <TextBlock Text="Rețetele care expiră în mai puțin de 7 zile sunt evidențiate pentru reînnoire." />
            </Border>
            <ItemsControl ItemsSource="{Binding Prescriptions}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitleText}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Concentration}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding Dosage}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding Doctor}" Style="{StaticResource MutedText}" />
                                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8" Margin="0,12" />
                                <TextBlock Text="{Binding ExpirationLabel}" Style="{StaticResource MutedText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Descarcă" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="reteta" Margin="0,0,8,0" />
                                    <Button Content="Reînnoire" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.IssuePrescriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
