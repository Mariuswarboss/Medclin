<UserControl x:Class="Mediclin.UI.Views.Patient.MyAppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Margin="24">

    <!-- ══ HEADER ══ -->
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Programările mele"
               Style="{StaticResource HeadingText}"
               Margin="0,0,0,16"/>

    <!-- Filter pills -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
      <Button Content="Toate" Padding="18,8" Margin="0,0,8,0"
              Command="{Binding SetFiltruCommand}" CommandParameter="Toate">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ActiveFilter}" Value="Toate">
                <Setter Property="Background"  Value="{StaticResource PrimaryLightBrush}"/>
                <Setter Property="Foreground"  Value="{StaticResource PrimaryGreenDarkBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="Viitoare" Padding="18,8" Margin="0,0,8,0"
              Command="{Binding SetFiltruCommand}" CommandParameter="Viitoare">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ActiveFilter}" Value="Viitoare">
                <Setter Property="Background"  Value="{StaticResource PrimaryLightBrush}"/>
                <Setter Property="Foreground"  Value="{StaticResource PrimaryGreenDarkBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="Finalizate" Padding="18,8" Margin="0,0,8,0"
              Command="{Binding SetFiltruCommand}" CommandParameter="Finalizate">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ActiveFilter}" Value="Finalizate">
                <Setter Property="Background"  Value="{StaticResource PrimaryLightBrush}"/>
                <Setter Property="Foreground"  Value="{StaticResource PrimaryGreenDarkBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Content="Anulate" Padding="18,8"
              Command="{Binding SetFiltruCommand}" CommandParameter="Anulate">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ActiveFilter}" Value="Anulate">
                <Setter Property="Background"  Value="{StaticResource PrimaryLightBrush}"/>
                <Setter Property="Foreground"  Value="{StaticResource PrimaryGreenDarkBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
    </StackPanel>

    <!-- Loading + error bars -->
    <StackPanel Grid.Row="2">
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,6"
                   Visibility="{Binding IsLoading,
                   Converter={StaticResource BoolToVisibilityConverter}}"/>
      <Border Background="#FCEDEC" CornerRadius="12" Padding="14,10"
              Margin="0,0,0,8"
              Visibility="{Binding ErrorMessage,
              Converter={StaticResource NullToVisibilityConverter}}">
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource ErrorRedBrush}"
                   FontSize="12" TextWrapping="Wrap"/>
      </Border>
    </StackPanel>

    <!-- ══ APPOINTMENTS LIST ══ -->
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <Grid>

        <!-- Empty state -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,80"
                    Visibility="{Binding IsEmpty,
                    Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="&#128197;" FontSize="56"
                     HorizontalAlignment="Center" Margin="0,0,0,16"/>
          <TextBlock Text="Nu există programări în această categorie"
                     Style="{StaticResource MutedText}"
                     HorizontalAlignment="Center" FontSize="14"/>
          <TextBlock Text="Poți face o programare din pagina de start."
                     Style="{StaticResource MutedText}"
                     HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- List -->
        <ItemsControl ItemsSource="{Binding FilteredAppointments}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource CardBorder}"
                      Margin="0,0,0,12" Padding="0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- Date badge -->
                  <Border CornerRadius="20,0,0,20"
                          Background="{StaticResource PrimaryLightBrush}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,20">
                      <TextBlock Text="{Binding ZiNumar}"
                                 FontSize="24" FontWeight="Bold"
                                 Foreground="{StaticResource PrimaryGreenDarkBrush}"
                                 HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding LunaText}"
                                 FontSize="10" FontWeight="SemiBold"
                                 Foreground="{StaticResource AccentGreenBrush}"
                                 HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding OraText}"
                                 FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 HorizontalAlignment="Center"
                                 Margin="0,6,0,0"/>
                    </StackPanel>
                  </Border>

                  <!-- Doctor + details -->
                  <StackPanel Grid.Column="1"
                              Margin="18,16,12,16"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding MedicComplet}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding SpecialitateNume}"
                               Style="{StaticResource MutedText}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding MotivVizita}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding MotivVizita,
                               Converter={StaticResource NullToVisibilityConverter}}"/>
                  </StackPanel>

                  <!-- Status + cancel -->
                  <StackPanel Grid.Column="2"
                              Margin="0,16,16,16"
                              VerticalAlignment="Center"
                              MinWidth="110">
                    <Border CornerRadius="20" Padding="12,6"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,8">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#F0F3F6"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Confirmata">
                              <Setter Property="Background" Value="{StaticResource BlueInfoBgBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="In_asteptare">
                              <Setter Property="Background" Value="#FFF3E0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="In_cabinet">
                              <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Finalizata">
                              <Setter Property="Background" Value="#EDF7F3"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Anulata">
                              <Setter Property="Background" Value="#FCEDEC"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Status}"
                                 FontSize="11" FontWeight="SemiBold"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                    <Button Content="Anuleaz&#259;"
                            Style="{StaticResource DangerButton}"
                            Padding="10,5" FontSize="11"
                            HorizontalAlignment="Right"
                            Command="{Binding DataContext.CancelAppointmentCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding CanCancel,
                            Converter={StaticResource BoolToVisibilityConverter}}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
