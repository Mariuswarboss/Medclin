<UserControl x:Class="Mediclin.UI.Views.Patient.MyEMRView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ReadOnlyMedicalTextBox" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="Se incarca fisa medicala..." Margin="0,12" Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel Margin="24">
                <Border Background="{DynamicResource ErrorBgBrush}"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,12"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource ErrorRedBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource PrimaryLightBrush}">
                            <TextBlock Text="{Binding Initiale}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryGreenDarkBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NumeComplet}" Style="{StaticResource HeadingText}" FontSize="26"/>
                            <TextBlock Text="{Binding MetaPacient}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding MedicPrincipalNume, StringFormat=Medic: {0}}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       FontSize="12"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding HasMedicPrincipal, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Visibility="{Binding HasMedicPrincipal, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Content="Solicita fisa de la medic"
                                        Command="{Binding RequestEMRFromDoctorCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="14,0"/>
                                <TextBlock Text="{Binding RequestEMRMessage}"
                                           FontSize="11"
                                           Foreground="{DynamicResource PrimaryGreenBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="260"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding RequestEMRMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasMedicPrincipal, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="Alege medicul de familie" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding AvailableMedici}"
                                              SelectedItem="{Binding SelectedMedicToAssign}"
                                              DisplayMemberPath="NumeCompletCuTitlu"
                                              Width="220"
                                              Style="{StaticResource RoundedComboBox}"/>
                                    <Button Command="{Binding AssignMedicCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Height="42"
                                            Width="42"
                                            MinWidth="42"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Content="OK"/>
                                </StackPanel>
                                <ProgressBar IsIndeterminate="True" Height="2" Margin="0,6,0,0"
                                             Visibility="{Binding IsAssigningMedic, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="SYMPTOM ENTRY" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Simptome si observatii clinice transmise de medic."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,14"/>
                                <TextBox Style="{StaticResource ReadOnlyMedicalTextBox}"
                                         Height="136"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         Text="{Binding LatestConsultatie.Simptome, Mode=OneWay, TargetNullValue='Nu sunt simptome transmise.'}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="ICD-10 DIAGNOSIS" Style="{StaticResource CardTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Cod final" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource ReadOnlyMedicalTextBox}"
                                                 Margin="0,6,0,0"
                                                 Text="{Binding LatestConsultatie.DiagnosticCod, Mode=OneWay, TargetNullValue='-'}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Descriere clinica" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource ReadOnlyMedicalTextBox}"
                                                 Margin="0,6,0,0"
                                                 Height="92"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalContentAlignment="Top"
                                                 Text="{Binding LatestConsultatie.Diagnostic, Mode=OneWay, TargetNullValue='Fara diagnostic completat'}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="PRESCRIPTIONS" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Retetele emise de medic apar automat aici dupa emitere."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,14"/>
                                <ItemsControl ItemsSource="{Binding RetetActive}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BackgroundSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderBrushNeutral}"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="14"
                                                    Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding MedicamenteText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding MedicNume, StringFormat=Emisa de {0}}" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource PrimaryLightBrush}" CornerRadius="14" Padding="10,6">
                                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource PrimaryGreenDarkBrush}" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Medicamente}" Margin="0,10,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,4,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding NumeScurt}" TextWrapping="Wrap"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding DozajText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nu exista retete active."
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Visibility="{Binding HasReteteActive, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="VITAL SIGNS" Style="{StaticResource CardTitle}"/>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Text="Tensiune" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource ReadOnlyMedicalTextBox}" Width="120" Margin="0,6,0,0" Text="{Binding LatestConsultatie.Tensiune, Mode=OneWay, TargetNullValue='-'}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Text="Puls" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource ReadOnlyMedicalTextBox}" Width="96" Margin="0,6,0,0" Text="{Binding LatestConsultatie.Puls, Mode=OneWay, TargetNullValue='-'}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Text="Temperatura" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource ReadOnlyMedicalTextBox}" Width="110" Margin="0,6,0,0" Text="{Binding LatestConsultatie.Temperatura, Mode=OneWay, TargetNullValue='-'}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Text="Greutate" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource ReadOnlyMedicalTextBox}" Width="110" Margin="0,6,0,0" Text="{Binding LatestConsultatie.Greutate, Mode=OneWay, TargetNullValue='-'}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Text="Inaltime" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource ReadOnlyMedicalTextBox}" Width="110" Margin="0,6,0,0" Text="{Binding LatestConsultatie.Inaltime, Mode=OneWay, TargetNullValue='-'}"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="CLINICAL NOTES" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="Recomandari pentru pacient" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource ReadOnlyMedicalTextBox}"
                                         Margin="0,6,0,0"
                                         Height="96"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         Text="{Binding LatestConsultatie.Recomandari, Mode=OneWay, TargetNullValue='Nu sunt recomandari transmise.'}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="ACTIVE ALLERGIES" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding Alergii}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource WarningBgBrush}" CornerRadius="14" Padding="10,6" Margin="0,0,8,8">
                                                <TextBlock Text="{Binding Substanta}" Foreground="{DynamicResource WarningAmberBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nu sunt alergii inregistrate."
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Visibility="{Binding HasAlergii, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="CHRONIC CONDITIONS" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding BolicCronice}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BackgroundSecondaryBrush}" CornerRadius="14" Padding="10,8" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Diagnostic}" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nu sunt boli cronice inregistrate."
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Visibility="{Binding HasBoliCronice, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="CONSULTATION HISTORY" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding IstoricConsltatii}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectConsultatieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="0"
                                                    Margin="0,0,0,10"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    HorizontalContentAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ItemBorder"
                                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                                BorderBrush="{DynamicResource BorderBrushNeutral}"
                                                                BorderThickness="1"
                                                                CornerRadius="18"
                                                                Padding="14">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}" />
                                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                                                <Setter TargetName="ItemBorder" Property="Cursor" Value="Hand" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DataText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding MedicSubtitlu}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding DiagnosticCuCod}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nu exista consultatii transmise."
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Visibility="{Binding HasConsultatie, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
