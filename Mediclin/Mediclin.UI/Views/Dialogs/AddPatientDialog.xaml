<Window x:Class="Mediclin.UI.Views.Dialogs.AddPatientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pacient nou" Width="500" MinHeight="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource BackgroundPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PrimaryGreenBrush}">
            <TextBlock Text="Pacient nou" Foreground="White" VerticalAlignment="Center" Margin="16,0" FontWeight="SemiBold" />
        </Border>
        <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Prenume" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Prenume, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}" Margin="0,4,0,10" />
                <TextBlock Text="Nume" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Nume, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}" Margin="0,4,0,10" />
                <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}" Margin="0,4,0,10" />
                <TextBlock Text="Parolă generată (trimiteți pacientului)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ParolaGenerata}" IsReadOnly="True" Style="{StaticResource RoundedTextBox}" Margin="0,4,0,10" />
                <TextBlock Text="Telefon" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Telefon}" Style="{StaticResource RoundedTextBox}" Margin="0,4,0,10" />
                <TextBlock Text="Data nașterii" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding DataNasterii}" Height="38" Margin="0,4,0,10" />
                <TextBlock Text="Sex" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding SexOptions}" SelectedItem="{Binding Sex}" Style="{StaticResource RoundedComboBox}" Margin="0,4,0,10" />
                <TextBlock Text="CNP" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Cnp}" Style="{StaticResource RoundedTextBox}" Margin="0,4,0,10" />
                <TextBlock Text="Grupa sanguină" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding GrupaOptions}" SelectedItem="{Binding GrupaSanguina}" Style="{StaticResource RoundedComboBox}" Margin="0,4,0,14" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorRedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Anulează" Style="{StaticResource SecondaryButton}" Command="{Binding AnuleazaCommand}" Margin="0,0,8,0" />
                    <Button Content="Adaugă pacient" Style="{StaticResource PrimaryButton}" Command="{Binding SalveazaCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
