<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryGreen">#37C8A0</Color>
    <Color x:Key="PrimaryGreenDark">#9EF3D6</Color>
    <Color x:Key="PrimaryGreenLight">#123E34</Color>
    <Color x:Key="AccentGreen">#4EE0B4</Color>
    <Color x:Key="TextPrimary">#F4F7FB</Color>
    <Color x:Key="TextSecondary">#CBD5E1</Color>
    <Color x:Key="TextTertiary">#94A3B8</Color>
    <Color x:Key="BorderColor">#314154</Color>
    <Color x:Key="BackgroundPrimary">#111827</Color>
    <Color x:Key="BackgroundSecondary">#0B1220</Color>
    <Color x:Key="SurfaceRaised">#172133</Color>
    <Color x:Key="SidebarHover">#203047</Color>
    <Color x:Key="SidebarAcrylic">#F0141D2B</Color>
    <Color x:Key="SidebarStroke">#334155</Color>
    <Color x:Key="ErrorRed">#F87171</Color>
    <Color x:Key="ErrorBg">#3B1720</Color>
    <Color x:Key="WarningAmber">#FBBF24</Color>
    <Color x:Key="WarningBg">#422006</Color>
    <Color x:Key="SuccessBg">#123E34</Color>
    <Color x:Key="NeutralPillBg">#1E293B</Color>
    <Color x:Key="BlueInfo">#60A5FA</Color>
    <Color x:Key="BlueBg">#172A4A</Color>
    <Color x:Key="ShadowColor">#80000000</Color>
    <Color x:Key="GlassOverlay">#2AFFFFFF</Color>
    <Color x:Key="Placeholder">#94A3B8</Color>
    <Color x:Key="InputBackground">#101827</Color>
    <Color x:Key="CardBackground">#172133</Color>

    <SolidColorBrush x:Key="PrimaryGreenBrush"      Color="{StaticResource PrimaryGreen}" />
    <SolidColorBrush x:Key="PrimaryGreenDarkBrush"  Color="{StaticResource PrimaryGreenDark}" />
    <SolidColorBrush x:Key="PrimaryGreenLightBrush" Color="{StaticResource PrimaryGreenLight}" />
    <SolidColorBrush x:Key="AccentGreenBrush"       Color="{StaticResource AccentGreen}" />
    <SolidColorBrush x:Key="TextPrimaryBrush"       Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush"     Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextTertiaryBrush"      Color="{StaticResource TextTertiary}" />
    <SolidColorBrush x:Key="TextMutedBrush"         Color="{StaticResource TextTertiary}" />
    <SolidColorBrush x:Key="PlaceholderBrush"       Color="{StaticResource Placeholder}" />
    <SolidColorBrush x:Key="BorderBrushNeutral"     Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BackgroundPrimaryBrush"   Color="{StaticResource BackgroundPrimary}" />
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondary}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush"     Color="{StaticResource SurfaceRaised}" />
    <SolidColorBrush x:Key="CardBackgroundBrush"    Color="{StaticResource CardBackground}" />
    <SolidColorBrush x:Key="InputBackgroundBrush"   Color="{StaticResource InputBackground}" />
    <SolidColorBrush x:Key="SidebarHoverBrush"      Color="{StaticResource SidebarHover}" />
    <SolidColorBrush x:Key="SidebarAcrylicBrush"    Color="{StaticResource SidebarAcrylic}" />
    <SolidColorBrush x:Key="SidebarStrokeBrush"     Color="{StaticResource SidebarStroke}" />
    <SolidColorBrush x:Key="ErrorRedBrush"          Color="{StaticResource ErrorRed}" />
    <SolidColorBrush x:Key="ErrorBgBrush"           Color="{StaticResource ErrorBg}" />
    <SolidColorBrush x:Key="WarningAmberBrush"      Color="{StaticResource WarningAmber}" />
    <SolidColorBrush x:Key="WarningBgBrush"         Color="{StaticResource WarningBg}" />
    <SolidColorBrush x:Key="SuccessBgBrush"         Color="{StaticResource SuccessBg}" />
    <SolidColorBrush x:Key="NeutralPillBgBrush"     Color="{StaticResource NeutralPillBg}" />
    <SolidColorBrush x:Key="BlueInfoBrush"          Color="{StaticResource BlueInfo}" />
    <SolidColorBrush x:Key="BlueInfoBgBrush"        Color="{StaticResource BlueBg}" />
    <SolidColorBrush x:Key="PrimaryLightBrush"      Color="{StaticResource PrimaryGreenLight}" />
    <SolidColorBrush x:Key="GlassOverlayBrush"      Color="{StaticResource GlassOverlay}" />

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1220" Offset="0" />
        <GradientStop Color="#111827" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
